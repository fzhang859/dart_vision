root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# C/C++
[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_size = 4
max_line_length = 100

# Python
[*.py]
indent_size = 4
max_line_length = 100

# JSON、YAML、XML及ROS配置
[*.{json,jsonc,yaml,yml,xml,rviz,urdf,xacro}]
indent_size = 2

# CMake
[*.cmake]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

# Shell
[*.{sh,bash,zsh}]
indent_size = 2

# TOML
[*.toml]
indent_size = 2

# Markdown保留有语义的行尾空格
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Make命令必须使用Tab
[Makefile]
indent_style = tab
indent_size = 4
